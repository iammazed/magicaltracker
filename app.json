{
  "expo": {
    "name": "MagicalTracker",
    "slug": "magicaltracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "magicaltracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A596E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00807E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "MagicalTracker needs access to your photos only when you choose to attach one to a visit you are logging. Photos stay on your device.",
          "cameraPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MagicalTracker uses your location while the app is open to sort restaurants by how close they are. It is never used in the background and never leaves your device.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
