# TEMPLATE ONLY — this file IS committed to git.
# Never put real values here. Copy it to `.env` and fill that in instead.
#
# THE RULE: only EXPO_PUBLIC_ vars may be read by the app. That prefix bakes the
# value into the shipped binary, where anyone can extract it. Everything without
# the prefix is for local scripts and migrations only.
#
# Note: these use Supabase's current key format (sb_publishable_… / sb_secret_…).
# The legacy anon / service_role keys are deprecated and retire at the end of 2026.

# ── Safe to ship ──────────────────────────────────────────────────────────
# Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard → Settings → API Keys → "Publishable and secret API keys" tab
# Replaces the old `anon` key. Designed to be public — Row Level Security is
# what protects your data, not the secrecy of this value.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ── Never ship. Never prefix with EXPO_PUBLIC_. ───────────────────────────

# Dashboard → Settings → Database → Connection string → "Transaction pooler"
# Use the POOLER string (port 6543), not Direct connection (port 5432) — direct
# is not IPv4-reachable on the free plan.
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:REPLACE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Dashboard → Settings → API Keys → same tab → create a secret key
# Replaces the old `service_role` key. BYPASSES Row Level Security entirely.
# Only for admin scripts (catalog import). Never in app code.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
